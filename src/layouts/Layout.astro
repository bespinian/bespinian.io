---
import { Font } from "astro:assets";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import SiteStructuredData from "../components/SiteStructuredData.astro";
import { useI18n } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  // Strips the navigation and footer down to the essentials, for landing pages
  // where every other link is just a way to leave.
  minimalNav?: boolean;
}

const { minimalNav = false } = Astro.props;

const { htmlLang } = useI18n(Astro.url);
const hasHeadSlot = Astro.slots.has("head");
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preconnect to external domains for performance -->
    <link rel="preconnect" href="https://scripts.simpleanalyticscdn.com" />
    <link rel="dns-prefetch" href="https://scripts.simpleanalyticscdn.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

    <Font cssVariable="--font-lato" preload />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-18327942303"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "AW-18327942303");
    </script>

    <!-- SEO and meta tags slot -->
    <slot name="head" />
    {!hasHeadSlot && <title>bespinian</title>}

    <SiteStructuredData />
  </head>
  <body>
    <Navigation minimal={minimalNav} />
    <main>
      <slot />
    </main>
    <Footer minimal={minimalNav} />

    <script
      is:inline
      async
      src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-lato);
  }
</style>
