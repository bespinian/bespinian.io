---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import SEO from "../../../components/SEO.astro";
import StructuredData from "../../../components/StructuredData.astro";
import Title from "../../../components/Title.astro";
import ServiceForm from "../../../components/ServiceForm.astro";
import { languages } from "../../../i18n/ui";
import { useI18n } from "../../../i18n/utils";
import { getCollectionByLanguage } from "../../../lib/paths";
import { serviceProof } from "../../../lib/serviceProof";
import spaceship from "../../../assets/spaceship1.svg";
import BackLink from "../../../components/BackLink.astro";

export async function getStaticPaths() {
  const allServices = await getCollection("services");

  return Object.keys(languages).flatMap((lang) => {
    const langService = allServices.find(({ id }) => id === lang);
    if (!langService) return [];

    return langService.data.map((service) => ({
      params: { slug: service.id, lang },
      props: { service },
    }));
  });
}

const { service } = Astro.props;

const { lang, translatePath, t } = useI18n(Astro.url);

const title = service.title;
const description = service.description;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Social proof for this service. Ids that no longer exist in the customers
// collection are simply skipped.
const proof = serviceProof[service.id];
const customers = await getCollectionByLanguage("customers", lang);
const logos = (proof?.logoIds ?? [])
  .map((id) => customers.find((c) => c.id === id))
  .filter((c) => c !== undefined);
const testimonial = proof?.testimonialId
  ? customers.find((c) => c.id === proof.testimonialId)
  : undefined;
---

<Layout>
  <SEO slot="head" {title} {description} {lang} />
  <StructuredData
    slot="head"
    schema={{
      type: "Service",
      name: title,
      description,
      serviceType: "Professional Services",
      url: canonicalUrl,
      provider: {
        name: "bespinian",
        url: new URL("/", Astro.site).toString(),
      },
    }}
  />
  <Title
    title={service.heading}
    subtitle={service.lede}
    eyebrow={title}
    {spaceship}
  />

  <div class="service-page" data-service={title}>
    <article>
      {
        logos.length > 0 && (
          <section class="logo-section">
            <div class="container">
              <p class="logo-title">{t("services.trustedby")}</p>
              <div class="logo-strip">
                {logos.map((customer) => (
                  <Image
                    src={customer.data.logo}
                    alt={customer.data.company}
                    class="customer-logo"
                  />
                ))}
              </div>
            </div>
          </section>
        )
      }

      <div class="service-content">
        <!-- Outcome first: an ad click arrives cold and wants to know what it
             gets before it reads about its own problems. -->
        <section class="container">
          <h2>{t("services.results")}</h2>
          <div class="result-cards">
            {
              service.results.list.map((item) => (
                <div class="result-card">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              ))
            }
          </div>
        </section>

        <div class="bg-dark">
          <section class="container">
            <h2>{t("services.challenges")}</h2>
            <p>{service.challenges.description}</p>
            <ul>
              {
                service.challenges.list.map((item) => (
                  <li>
                    <strong>{item.title}</strong>: {item.description}
                  </li>
                ))
              }
            </ul>
          </section>
        </div>

        <section class="container">
          <h2>{t("services.approach")}</h2>
          <p>{service.approach.description}</p>
          <ol>
            {
              service.approach.list.map((item) => (
                <li>
                  <strong>{item.title}</strong>: {item.description}
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </article>
  </div>

  {
    testimonial && (
      <section class="testimonial-section">
        <div class="container">
          <blockquote class="testimonial-quote">
            {`"${testimonial.data.quote}"`}
          </blockquote>
          <div class="testimonial-author">
            {testimonial.data.authorImage && (
              <Image
                src={testimonial.data.authorImage}
                alt=""
                width={96}
                height={96}
                class="author-portrait"
              />
            )}
            <div>
              <p class="author-name">{testimonial.data.authorName}</p>
              <p class="author-title">
                {testimonial.data.authorTitle}, {testimonial.data.company}
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <ServiceForm service={title} />

  <!-- Below the form on purpose: it is a way out of the page, so it should not
       sit in the reading path of someone who arrived from a search ad. -->
  <footer class="service-footer">
    <div class="container">
      <BackLink
        href={translatePath("/#services")}
        text={t("nav.backToServices")}
      />
    </div>
  </footer>

  <script>
    declare global {
      interface Window {
        gtag?: (...args: unknown[]) => void;
      }
    }

    const service =
      document.querySelector<HTMLElement>("[data-service]")?.dataset.service ??
      "unknown";

    // How far people read before leaving, to tell "nobody scrolls past the
    // hero" apart from "they read everything and still didn't get in touch".
    const reportedDepths = new Set<number>();
    const trackScrollDepth = () => {
      const scrollable = document.body.scrollHeight - window.innerHeight;
      if (scrollable <= 0) return;
      const percent = ((window.scrollY / scrollable) * 100) | 0;

      for (const depth of [50, 90]) {
        if (percent >= depth && !reportedDepths.has(depth)) {
          reportedDepths.add(depth);
          window.gtag?.("event", "service_scroll_depth", {
            percent: depth,
            service,
          });
        }
      }
      if (reportedDepths.size === 2) {
        window.removeEventListener("scroll", trackScrollDepth);
      }
    };
    window.addEventListener("scroll", trackScrollDepth, { passive: true });
  </script>
</Layout>

<style>
  .service-page {
    padding: var(--spacing-lg) 0;
    min-height: calc(100vh - 400px);
  }

  .container {
    max-width: var(--content-wide-max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .bg-dark {
    padding-top: 1rem;
    padding-bottom: 4rem;
    background-color: var(--color-background-primary);
    color: var(--color-secondary);
  }

  .service-content .bg-dark h2 {
    color: var(--color-secondary);
  }

  .service-footer {
    padding: 3rem 0;
  }

  .logo-section {
    padding-bottom: 1rem;
  }

  .logo-title {
    text-align: center;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray);
    margin: 0 0 2rem;
  }

  .logo-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem 3rem;
  }

  .customer-logo {
    max-height: 2.5rem;
    max-width: 8rem;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .service-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-dark);
  }

  .service-content p {
    margin: 0 0 1.5rem 0;
  }

  .service-content h2 {
    font-size: 2.5rem;
    margin: 3rem 0 1.5rem 0;
    color: var(--color-primary);
  }

  .service-content h3 {
    font-size: 1.75rem;
    margin: 2rem 0 1rem 0;
    color: var(--color-text-dark);
  }

  .service-content ul,
  .service-content ol {
    margin: 0 0 1.5rem 0;
    padding-left: 2rem;
  }

  .service-content li {
    margin-bottom: 1rem;
  }

  /* Was a two-column table, which shrinks to 0.875rem on phones — where most
   ad clicks come from. Cards stack instead of squeezing. */
  .result-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .result-card {
    padding: 1.5rem;
    background: var(--color-background-tertiary);
    border-radius: var(--card-border-radius);
  }

  .service-content .result-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    color: var(--color-primary);
  }

  .service-content .result-card p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.7;
  }

  .testimonial-section {
    background-color: var(--color-background-primary);
    color: var(--color-secondary);
    padding: 4rem 0;
    margin-top: 4rem;
  }

  .testimonial-quote {
    font-size: 1.4rem;
    font-style: italic;
    line-height: 1.6;
    margin: 0 0 2rem;
    text-align: center;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .author-portrait {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .author-name {
    font-weight: bold;
    margin: 0;
  }

  .author-title {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    opacity: 0.85;
  }

  @media (min-width: 48rem) {
    .result-cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service-content a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .service-content a:hover {
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .service-page {
      padding: var(--spacing-md) 0;
    }

    .service-content {
      font-size: 1rem;
    }

    .service-content h2 {
      font-size: 2rem;
    }

    .service-content h3 {
      font-size: 1.5rem;
    }

    .testimonial-quote {
      font-size: 1.2rem;
    }
  }
</style>
