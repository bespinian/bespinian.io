---
import Layout from "../layouts/Layout.astro";
import SEO from "../components/SEO.astro";
import Hero from "../components/Hero.astro";
import WhyUs from "../components/WhyUs.astro";
import Customers from "../components/Customers.astro";
import Services from "../components/Services.astro";
import Work from "../components/Work.astro";
import CtaBanner from "../components/CtaBanner.astro";
import { useI18n } from "../i18n/utils";

const { t, lang } = useI18n(Astro.url);

const title = `${t("hero.title1")} ${t("hero.title2")}`;
const description = t("hero.description");

// `/` serves the same markup as `/en/`. Without this the two compete as
// duplicates, and the one Google picks is a coin flip.
const canonicalOverride =
  Astro.url.pathname === "/" ? { canonicalPath: "/en/" } : {};
---

<Layout>
  <SEO slot="head" {title} {description} {lang} {...canonicalOverride} />
  <Hero />
  <WhyUs />
  <Customers />
  <Services />
  <Work />

  <!-- The hero CTA is the only ask above the fold. Someone who scrolled all
       the way past the work section shouldn't have to scroll back up. -->
  <section class="closing-cta">
    <CtaBanner source="home" />
  </section>
</Layout>

<style>
  .closing-cta {
    padding: 0 2rem 6rem;
  }

  .closing-cta > :global(.cta-banner) {
    max-width: var(--content-wide-max-width);
    margin: 0 auto;
  }
</style>
