---
import { getCollection } from "astro:content";
import bespinianWhite from "../assets/bespinian-white.svg";
import { useI18n } from "../i18n/utils";

interface Props {
  // Landing-page mode: contact details and the legal line only. The nav is
  // already stripped on those pages so a click can't leave before converting,
  // and a footer full of links would put every one of those exits back.
  minimal?: boolean;
}

const { minimal = false } = Astro.props;

const { lang, t, translatePath } = useI18n(Astro.url);

// Service links in the footer do double duty: they are the shortest path from
// a blog post to a commercial page, and they give every page an internal link
// to the pages we actually want ranking.
const servicesEntry = minimal
  ? []
  : await getCollection("services", ({ id }) => id === lang);
const services = servicesEntry[0]?.data ?? [];

const company = [
  { label: t("about.mission.title"), href: translatePath("/about") },
  { label: t("about.team.title"), href: translatePath("/about/team") },
  { label: t("customers.page.title"), href: translatePath("/customers") },
  { label: t("nav.blog"), href: translatePath("/blog") },
  { label: t("jobs.title"), href: translatePath("/about/jobs") },
];
---

<footer>
  <div class={`container ${minimal ? "minimal" : ""}`}>
    <div class="column brand">
      {
        minimal ? (
          <img id="logo" src={bespinianWhite.src} alt="bespinian logo" />
        ) : (
          <a href={translatePath("/")}>
            <img id="logo" src={bespinianWhite.src} alt="bespinian logo" />
          </a>
        )
      }
      <p class="tagline">{t("footer.tagline")}</p>
    </div>

    {
      services.length > 0 && (
        <nav class="column" aria-label={t("footer.services")}>
          <p class="column-title">{t("footer.services")}</p>
          {services.map((service) => (
            <a href={translatePath(`/services/${service.id}`)}>
              {service.title}
            </a>
          ))}
        </nav>
      )
    }

    {
      !minimal && (
        <nav class="column" aria-label={t("footer.company")}>
          <p class="column-title">{t("footer.company")}</p>
          {company.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      )
    }

    <div class="column">
      <p class="column-title">{t("footer.contact")}</p>
      {
        /* Marked up so the address is machine-readable and matches the
          Organization schema and the imprint word for word. */
      }
      <address>
        <span class="office">{t("footer.office")}</span>
        Kramgasse 68<br />
        3011 Bern<br />
        Switzerland
      </address>
      <a href="mailto:info@bespinian.io">info@bespinian.io</a>
      {!minimal && <a href={translatePath("/contact")}>{t("nav.contact")}</a>}
    </div>

    {
      !minimal && (
        <nav class="column" aria-label={t("footer.follow")}>
          <p class="column-title">{t("footer.follow")}</p>
          <a
            href="https://www.linkedin.com/company/19074419"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
          <a
            href="https://www.youtube.com/@bespinian-io"
            target="_blank"
            rel="noopener noreferrer"
          >
            YouTube
          </a>
          <a
            href="https://github.com/bespinian"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>
          <a href="/rss.xml">RSS</a>
        </nav>
      )
    }
  </div>

  <div class="legal">
    <p>
      {
        t("footer.copyright").replace(
          "{year}",
          new Date().getFullYear().toString(),
        )
      }
    </p>
    <a href={translatePath("/imprint")}>{t("footer.imprint")}</a>
  </div>
</footer>

<style>
  footer {
    padding: 2rem;
    padding-top: 4rem;
    background-color: var(--color-primary);
    color: var(--color-secondary);
  }

  .container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .column-title {
    margin: 0;
    font-weight: 700;
    opacity: 0.7;
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .brand {
    gap: 1.5rem;
  }

  #logo {
    max-height: 2.5rem;
    align-self: flex-start;
  }

  .tagline {
    margin: 0;
    max-width: 22rem;
    line-height: 1.6;
    opacity: 0.85;
  }

  address {
    font-style: normal;
    line-height: 1.6;
    opacity: 0.85;
  }

  .office {
    display: block;
    opacity: 0.7;
  }

  a {
    text-decoration: none;
    color: var(--color-secondary);
  }

  a:hover {
    color: var(--color-background-tertiary);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .legal p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .container {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .container {
      grid-template-columns: 1.4fr repeat(4, 1fr);
      gap: 2rem;
    }

    .container.minimal {
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
