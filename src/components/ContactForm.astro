---
import { useI18n } from "../i18n/utils";

const { t } = useI18n(Astro.url);
---

<section id="contact-section">
  <h2 id="form">{t("contact.form.title")}</h2>

  <div class="container">
    <form
      id="contact-form"
      class="contact-form"
      action="https://formspree.io/f/mojgggre"
      method="POST"
    >
      <div class="field">
        <input
          class="input"
          name="name"
          placeholder={t("contact.form.nameplaceholder")}
          aria-label={t("contact.form.nameplaceholder")}
          required
        />
      </div>
      <div class="field">
        <input
          class="input"
          type="email"
          name="email"
          placeholder={t("contact.form.emailplaceholder")}
          aria-label={t("contact.form.emailplaceholder")}
          required
        />
      </div>
      <div class="field">
        <input
          class="input"
          name="subject"
          placeholder={t("contact.form.subjectplaceholder")}
          aria-label={t("contact.form.subjectplaceholder")}
          required
        />
      </div>
      <div class="field">
        <textarea
          class="textarea"
          name="message"
          placeholder={t("contact.form.messageplaceholder")}
          aria-label={t("contact.form.messageplaceholder")}
          rows="8"
          required></textarea>
      </div>
      <div class="field">
        <button type="submit" class="button">
          {t("contact.form.sendbuttonlabel")}
        </button>
        <p class="reassurance">{t("contact.form.reassurance")}</p>
      </div>
    </form>
  </div>

  <script>
    declare global {
      interface Window {
        gtag?: (...args: unknown[]) => void;
      }
    }

    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;

    // Mirrors the service form: the general contact form is a conversion too,
    // and without this it is invisible in the ads reporting.
    form?.addEventListener("submit", (event) => {
      event.preventDefault();

      let submitted = false;
      const submitOnce = () => {
        if (submitted) return;
        submitted = true;
        form.submit();
      };

      if (typeof window.gtag === "function") {
        window.gtag("event", "conversion", {
          send_to: "AW-18327942303/qHd6CO2SwtMcEJ_puKNE",
          event_callback: submitOnce,
        });
        // Fallback in case gtag is blocked or the callback never fires.
        setTimeout(submitOnce, 1000);
      } else {
        submitOnce();
      }
    });
  </script>

  <style>
    #contact-section {
      padding: 2rem 2rem 4rem;
      max-width: 64rem;
      margin: 0 auto;
    }

    .container {
      width: 100%;
    }

    .contact-form {
      width: 100%;
      margin-top: 4rem;
    }

    .field {
      margin-bottom: 1.5rem;
    }

    .reassurance {
      margin: 1rem 0 0;
      font-size: 0.95rem;
      line-height: 1.5;
      color: var(--color-gray);
    }

    .input,
    .textarea {
      width: calc(100% - 2rem);
      padding: 1rem;
      font-size: 1rem;
      border: 1px solid #ddd;
      border-radius: 4px;
      font-family: var(--font-lato);
      transition: border-color 0.3s ease;
    }

    .input:focus,
    .textarea:focus {
      outline: none;
      border-color: var(--color-primary);
    }

    .textarea {
      resize: vertical;
      min-height: 8rem;
    }

    .button {
      width: 100%;
      padding: 1rem 2rem;
      font-size: 1rem;
      font-weight: 600;
      font-family: var(--font-lato);
      color: var(--color-secondary);
      background-color: var(--color-primary);
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .button:hover {
      background-color: var(--color-background-primary);
    }

    h2 {
      font-size: 2rem;
      margin-bottom: var(--spacing-sm);
    }
  </style>
</section>
