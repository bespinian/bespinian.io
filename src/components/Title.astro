---
import type { ImageMetadata } from "astro";
import cloudLarge from "../assets/cloud-large.svg";
import cloudDarkMedium from "../assets/cloud-dark-medium.svg";

interface Props {
  title: string;
  subtitle?: string;
  // Small line above the headline. On landing pages it carries the phrase the
  // visitor searched or clicked on, while the headline leads with the outcome.
  eyebrow?: string;
  spaceship?: ImageMetadata;
  // The spaceship slot also carries product logos. Those are wider and denser
  // than the decorative art, so they need a tighter cap to stay a mark in the
  // corner instead of filling the header on a wide screen.
  spaceshipIsLogo?: boolean;
}

const { title, subtitle, eyebrow, spaceship, spaceshipIsLogo } = Astro.props;
---

<section id="container">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  <p>{subtitle}</p>
  {spaceship && (
    <img
      id="spaceship"
      class={spaceshipIsLogo ? "logo" : undefined}
      src={spaceship.src}
      alt=""
    />
  )}
  <img id="cloud-dark-medium" src={cloudDarkMedium.src} alt="" />
  <img id="cloud-large" src={cloudLarge.src} alt="" />
</section>

<style>
  #container {
    position: relative;
    padding: 2rem;
    background-color: var(--color-background-primary);
    color: var(--color-secondary);
    overflow: hidden;
  }

  .eyebrow {
    position: relative;
    margin-top: 2rem;
    margin-bottom: 0;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.9;
    z-index: 100;
  }

  .eyebrow + h1 {
    margin-top: 0.75rem;
  }

  h1 {
    position: relative;
    width: 100%;
    margin-top: 2rem;
    margin-bottom: 8rem;
    max-width: 76rem;
    font-size: 2rem;
    font-weight: 600;
    z-index: 100;
  }

  p {
    position: relative;
    width: 100%;
    max-width: 42rem;
    font-size: 1.3rem;
    z-index: 100;
  }

  #spaceship {
    position: absolute;
    right: max(calc(10% - 1rem), 1rem);
    bottom: max(calc(10% - 1rem), 1rem);
    max-height: 75%;
    max-width: calc(100vw - 58rem);
    z-index: 3;
  }

  /* Keeps the same "only if there is room beside the copy" behaviour, with an
     absolute ceiling once the viewport is wide enough for the cap to bite. */
  #spaceship.logo {
    max-height: 55%;
    max-width: min(22rem, calc(100vw - 58rem));
  }

  #cloud-large {
    position: absolute;
    top: 4rem;
    right: -2rem;
    max-height: 35%;
    max-width: calc(100vw - 78rem);
    z-index: 2;
  }

  #cloud-dark-medium {
    position: absolute;
    top: 0;
    right: -2rem;
    max-height: 40%;
    max-width: 60%;
    z-index: 1;
  }

  @media (min-width: 48rem) {
    h1 {
      font-size: 4rem;
      margin-bottom: 8rem;
    }
  }

  @media (min-width: 64rem) {
    h1 {
      font-size: 6rem;
      margin-bottom: 12rem;
    }

    p {
      font-size: 1.6rem;
    }
  }
</style>
