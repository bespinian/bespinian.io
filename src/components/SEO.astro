---
import { languages, defaultLang } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  lang?: string;
  // Languages this page genuinely exists in. Anything not listed serves the
  // default-language text and is treated as a duplicate of it. Defaults to all
  // languages, which is right for pages built from the i18n dictionaries.
  translatedLangs?: string[];
  // Absolute path to point the canonical at, for pages reachable under more
  // than one URL. Overrides the self-referencing default.
  canonicalPath?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  article = false,
  publishedTime,
  modifiedTime,
  author,
  tags,
  noindex = false,
  lang = "en",
  translatedLangs = Object.keys(languages),
  canonicalPath,
} = Astro.props;

// Extract language from URL path
const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const hasTrailingSlash = Astro.url.pathname.endsWith("/");

// Build a URL for this same page in another language. Trailing slashes are
// preserved: canonical and hreflang have to agree exactly, or Google discards
// the annotation.
const getAlternateUrl = (language: string) => {
  const pathWithoutLang = pathParts.slice(1).join("/");
  const suffix = pathWithoutLang ? `/${pathWithoutLang}` : "";
  const path = `/${language}${suffix}${hasTrailingSlash ? "/" : ""}`;
  return new URL(path, Astro.site).toString();
};

// A page that only exists in the default language is served under every
// language prefix. Pointing those copies at the default-language URL keeps the
// ranking signals on one page instead of splitting them three ways.
const isUntranslatedCopy = !translatedLangs.includes(lang);

const canonicalURL = canonicalPath
  ? new URL(canonicalPath, Astro.site).toString()
  : isUntranslatedCopy
    ? getAlternateUrl(defaultLang)
    : new URL(Astro.url.pathname, Astro.site).toString();

// Default social image if none provided
const socialImage = image
  ? new URL(image, Astro.site).toString()
  : new URL("/og-default.jpg", Astro.site).toString();

// Full title with site name
const fullTitle = title.includes("bespinian") ? title : `${title} | bespinian`;

// hreflang describes a set of genuine translations. On an untranslated copy it
// would only contradict the canonical, so it is left off entirely and the
// canonical target carries the cluster.
const alternates = isUntranslatedCopy
  ? []
  : translatedLangs.filter((language) => language in languages);
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="bespinian" />
<meta name="theme-color" content="#3273dc" />
{
  /* `follow` on purpose: these pages are kept out of the index, but the links
    they carry into the real content should still be crawled. */
}
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang Tags for Internationalization -->
{
  alternates.map((language) => (
    <link
      rel="alternate"
      hreflang={language === "ch" ? "de-CH" : language}
      href={getAlternateUrl(language)}
    />
  ))
}
{
  alternates.includes(defaultLang) && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAlternateUrl(defaultLang)}
    />
  )
}

<!-- Facebook Meta Tags -->
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta
  property="og:locale"
  content={lang === "de" || lang === "ch" ? "de_DE" : "en_US"}
/>
<meta property="og:site_name" content="bespinian" />

{
  article && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  article && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}
{article && author && <meta property="article:author" content={author} />}
{
  article &&
    tags &&
    tags.map((tag) => <meta property="article:tag" content={tag} />)
}

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta property="twitter:domain" content="bespinian.io" />
<meta property="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
